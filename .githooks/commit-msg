#!/bin/sh

message_file="$1"

# Merge/revert commits generated by Git itself are exempt.
if grep -Eq '^(Merge|Revert) ' "$message_file"; then
  exit 0
fi

required_labels='問題：
変更前：
判断理由：
変更内容：
変更後：
確認結果：
未解決：'

missing=""
while IFS= read -r label; do
  if ! grep -Eq "^${label}[[:space:]]*[^[:space:]].*" "$message_file"; then
    missing="${missing}${label} "
  fi
done <<EOF
$required_labels
EOF

if [ -n "$missing" ]; then
  echo "コミットを中止しました。判断ロジックの必須項目が不足しています。" >&2
  echo "未入力または不足: $missing" >&2
  echo "git commit を引数なしで実行するとテンプレートが開きます。" >&2
  exit 1
fi

exit 0
